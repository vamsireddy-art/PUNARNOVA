# PunarNova - Environment Configuration

# Next.js App
NEXT_PUBLIC_APP_NAME="PunarNova"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python FastAPI ML Service
NEXT_PUBLIC_ML_SERVICE_URL="http://127.0.0.1:8000"

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY>"

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="<YOUR_RAZORPAY_KEY_ID>"
RAZORPAY_KEY_SECRET="<YOUR_RAZORPAY_KEY_SECRET>"

# SMS OTP Provider (e.g. Twilio / Fast2SMS / MSG91)
SMS_OTP_PROVIDER_API_KEY="<YOUR_SMS_OTP_PROVIDER_API_KEY>"

# Resend Email OTP
RESEND_API_KEY="<YOUR_RESEND_API_KEY>"
RESEND_FROM_EMAIL="onboarding@resend.dev"
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW=3600000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60000

# Google OAuth
GOOGLE_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<YOUR_GOOGLE_CLIENT_SECRET>"
