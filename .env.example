# PunarNova Environment Variables Template
# Copy this structure into Vercel Dashboard -> Settings -> Environment Variables

# App Config
NEXT_PUBLIC_APP_NAME="PunarNova"
NEXT_PUBLIC_APP_URL="https://your-deployment-url.vercel.app"

# FastAPI ML Service
NEXT_PUBLIC_ML_SERVICE_URL="http://127.0.0.1:8000"

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gmail SMTP for OTP Delivery (Nodemailer)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Resend API Key (Optional)
RESEND_API_KEY="your-resend-api-key"
