# PunarNova - Environment Configuration

# Next.js App
NEXT_PUBLIC_APP_NAME="PunarNova"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python FastAPI ML Service
NEXT_PUBLIC_ML_SERVICE_URL="http://127.0.0.1:8000"

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKey"

# SMS OTP Provider (e.g. Twilio / Fast2SMS / MSG91)
SMS_OTP_PROVIDER_API_KEY="your-sms-api-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
